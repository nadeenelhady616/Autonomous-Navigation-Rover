<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="person_walking">
    <static>true</static>

    <link name="link">

      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.10</radius>
            <length>1.0</length>
          </cylinder>
        </geometry>
      </collision>

      <visual name="visual">
        <pose>0 0 -0.02 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://person_walking/meshes/walking.dae</uri>
            <scale>0.25 0.25 0.25</scale>
          </mesh>
        </geometry>
      </visual>

    </link>
  </model>
</sdf>
